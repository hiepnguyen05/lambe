NODE_ENV=development
PORT=5000
# Set this only when the API is behind a trusted reverse proxy.
TRUST_PROXY="false"

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=lambe_db

PGADMIN_EMAIL=admin@lambe.com
PGADMIN_PASSWORD=admin_password

# Database URL for Prisma (connecting to local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/lambe_db?schema=public"

# Optional Redis cache. The backend keeps working against PostgreSQL when disabled/unavailable.
REDIS_ENABLED="false"
REDIS_URL="redis://localhost:6379"
REDIS_DEFAULT_TTL_SECONDS="300"
REDIS_CONNECT_TIMEOUT_MS="3000"

# Cloudinary media storage. Keep disabled until all credentials are configured.
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SpeedSMS Credentials
# Obtain the token from SpeedSMS Connect -> Settings -> Profile.
SPEEDSMS_ACCESS_TOKEN="YOUR_SPEEDSMS_ACCESS_TOKEN"
SPEEDSMS_API_URL="https://api.speedsms.vn/index.php"
SPEEDSMS_SMS_TYPE="4"
SPEEDSMS_SENDER=""
SPEEDSMS_TIMEOUT_MS="10000"

# Security credentials (generate independent random values of at least 32 characters)
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="7d"
OTP_HASH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Internal admin/moderator authentication
INTERNAL_JWT_SECRET="CHANGE_ME_TO_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
INTERNAL_ACCESS_TOKEN_EXPIRES_IN="15m"
INTERNAL_REFRESH_TOKEN_EXPIRES_DAYS="7"
INTERNAL_MAX_FAILED_ATTEMPTS="5"
INTERNAL_LOCK_DURATION_MINUTES="15"
INTERNAL_REFRESH_COOKIE_NAME="lambe_internal_refresh"

# Comma-separated origins. Required in production.
CORS_ORIGIN="http://localhost:5173"
