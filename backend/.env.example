NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=lambe_db

PGADMIN_EMAIL=admin@lambe.com
PGADMIN_PASSWORD=admin_password

# Database URL for Prisma (connecting to local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/lambe_db?schema=public"

# SpeedSMS Credentials
# Obtain the token from SpeedSMS Connect -> Settings -> Profile.
SPEEDSMS_ACCESS_TOKEN="YOUR_SPEEDSMS_ACCESS_TOKEN"
SPEEDSMS_API_URL="https://api.speedsms.vn/index.php"
SPEEDSMS_SMS_TYPE="4"
SPEEDSMS_SENDER=""
SPEEDSMS_TIMEOUT_MS="10000"

# Security credentials (generate independent random values of at least 32 characters)
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="7d"
OTP_HASH_SECRET="CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Comma-separated origins. Required in production.
CORS_ORIGIN="http://localhost:5173"
