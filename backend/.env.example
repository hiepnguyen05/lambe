# App
NODE_ENV=development
PORT=5000
LAMBE_API_HOST_PORT=5000
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY="false"

# PostgreSQL - Neon (copy the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://<owner>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<owner>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require"

# Upstash Redis - copy the TCP connection string from Upstash Console > Connect > TCP.
# Upstash requires TLS. Keep this credential on the backend only.
REDIS_ENABLED="true"
REDIS_URL="rediss://default:<UPSTASH_REDIS_PASSWORD>@<UPSTASH_REDIS_HOST>:6379"
REDIS_DEFAULT_TTL_SECONDS="300"
REDIS_CONNECT_TIMEOUT_MS="5000"
REDIS_COMMAND_TIMEOUT_MS="1000"
FEED_CACHE_ENABLED="false"
FEED_SAFETY_ENABLED="true"
FEED_CACHE_POST_TTL_SECONDS="120"
FEED_CACHE_TIMEOUT_MS="100"
FEED_CACHE_INDEX_ENABLED="false"
FEED_RECOMMENDATIONS_ENABLED="false"
FEED_CACHE_INDEX_TTL_SECONDS="300"
FEED_CACHE_LOCK_TTL_SECONDS="5"
FEED_CACHE_BATCH_SIZE="50"
FEED_CACHE_WORKER_INTERVAL_MS="5000"
PROVIDER_LOCATION_TTL_SECONDS="120"
PROVIDER_MIN_RECEIVING_BALANCE="50000"

# Internal route engine (requires Docker Compose --profile routing)
OSRM_URL="http://osrm:5000"

# JWT and security
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="15m"
USER_REFRESH_TOKEN_EXPIRES_DAYS="30"
INTERNAL_JWT_SECRET="CHANGE_ME_TO_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
INTERNAL_ACCESS_TOKEN_EXPIRES_IN="15m"
INTERNAL_REFRESH_TOKEN_EXPIRES_DAYS="7"
INTERNAL_MAX_FAILED_ATTEMPTS="5"
INTERNAL_LOCK_DURATION_MINUTES="15"
INTERNAL_REFRESH_COOKIE_NAME="lambe_internal_refresh"

# Firebase Phone Authentication
FIREBASE_ENABLED="true"
FIREBASE_PROJECT_ID="lambe-f7213"
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/firebase-service-account.json"
# Chỉ dùng khi chạy Firebase Auth Emulator, ví dụ: firebase-auth-emulator:9099
FIREBASE_AUTH_EMULATOR_HOST=""

# Cloudinary
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_KYC_UPLOAD_PRESET=""
CLOUDINARY_CHAT_UPLOAD_PRESET=""
CLOUDINARY_PRIVATE_URL_TTL_SECONDS="300"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# KYC
KYC_ENCRYPTION_KEY=""

# Email - Gmail SMTP
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-account@gmail.com"
SMTP_APP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
MAIL_FROM_NAME="Lambe Home Beauty"
MAIL_REPLY_TO=""
SMTP_CONNECTION_TIMEOUT_MS="10000"

# API monitor (run independently or with the ops_monitor Compose service)
OPS_ALERT_EMAILS=""
MONITOR_INTERVAL_SECONDS="60"

# MoMo sandbox top-up (MOMO_IPN_URL must be a public HTTPS URL, e.g. ngrok)
MOMO_ENABLED="false"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_PARTNER_NAME="Lambe Test"
MOMO_STORE_ID="LambeTestStore"
MOMO_IPN_URL="https://YOUR_NGROK_DOMAIN.ngrok-free.app/api/payments/momo/ipn"
MOMO_REDIRECT_URL="https://YOUR_NGROK_DOMAIN.ngrok-free.app/api/payments/momo/return"

# SePay Payment Gateway sandbox
SEPAY_ENABLED="false"
SEPAY_ENVIRONMENT="sandbox"
SEPAY_MERCHANT_ID=""
SEPAY_SECRET_KEY=""
SEPAY_PUBLIC_BASE_URL="https://YOUR_NGROK_DOMAIN.ngrok-free.app"
SEPAY_IPN_URL="https://YOUR_NGROK_DOMAIN.ngrok-free.app/api/payments/sepay/ipn"

# AI beauty consultation (server only)
GEMINI_ENABLED="false"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_WEB_SEARCH_ENABLED="false"
GEMINI_SEARCH_MODEL="gemini-3.8-flash"
