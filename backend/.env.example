# App
NODE_ENV=development
PORT=5000
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY="false"

# PostgreSQL - Docker network
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=lambe_db
DATABASE_URL="postgresql://postgres:postgres_password@postgres:5432/lambe_db?schema=public"

# Redis - Docker network
REDIS_ENABLED="true"
REDIS_URL="redis://redis:6379"
REDIS_DEFAULT_TTL_SECONDS="300"
REDIS_CONNECT_TIMEOUT_MS="3000"

# JWT and security
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_EXPIRES_IN="7d"
INTERNAL_JWT_SECRET="CHANGE_ME_TO_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
INTERNAL_ACCESS_TOKEN_EXPIRES_IN="15m"
INTERNAL_REFRESH_TOKEN_EXPIRES_DAYS="7"
INTERNAL_MAX_FAILED_ATTEMPTS="5"
INTERNAL_LOCK_DURATION_MINUTES="15"
INTERNAL_REFRESH_COOKIE_NAME="lambe_internal_refresh"

# Firebase Phone Authentication
FIREBASE_ENABLED="true"
FIREBASE_PROJECT_ID="lambe-f7213"
GOOGLE_APPLICATION_CREDENTIALS="/run/secrets/firebase-service-account.json"
# Chỉ dùng khi chạy Firebase Auth Emulator, ví dụ: firebase-auth-emulator:9099
FIREBASE_AUTH_EMULATOR_HOST=""

# Cloudinary
CLOUDINARY_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_KYC_UPLOAD_PRESET=""
CLOUDINARY_PRIVATE_URL_TTL_SECONDS="300"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# KYC
KYC_ENCRYPTION_KEY=""

# Email - Gmail SMTP
MAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-account@gmail.com"
SMTP_APP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
MAIL_FROM_NAME="Lambe Home Beauty"
MAIL_REPLY_TO=""
SMTP_CONNECTION_TIMEOUT_MS="10000"
