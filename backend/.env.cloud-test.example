# Copy to .env.cloud-test (ignored by git). Fill in the exact test-only URLs.
# Neon: create a separate branch and an EMPTY lambe_booking_test_* database in it.
# The pooled and direct URLs must refer to the same test branch, database and role.
NODE_ENV=test
TEST_TARGET=cloud
TEST_CLOUD_POSTGRES_HOST=ep-your-test-branch-pooler.c-5.ap-southeast-1.aws.neon.tech
DATABASE_URL="postgresql://test_role:TEST_PASSWORD@ep-your-test-branch-pooler.c-5.ap-southeast-1.aws.neon.tech/lambe_booking_test_cloud?sslmode=require"
TEST_DATABASE_URL="postgresql://test_role:TEST_PASSWORD@ep-your-test-branch-pooler.c-5.ap-southeast-1.aws.neon.tech/lambe_booking_test_cloud?sslmode=require"
DIRECT_URL="postgresql://test_role:TEST_PASSWORD@ep-your-test-branch.c-5.ap-southeast-1.aws.neon.tech/lambe_booking_test_cloud?sslmode=require"
TEST_DIRECT_URL="postgresql://test_role:TEST_PASSWORD@ep-your-test-branch.c-5.ap-southeast-1.aws.neon.tech/lambe_booking_test_cloud?sslmode=require"

# A NEW Upstash database, not a logical DB within Lambe's existing Upstash.
# Use the TCP connection string; no /15 suffix.
REDIS_ENABLED=true
TEST_CLOUD_REDIS_HOST=your-test-database.upstash.io
REDIS_URL="rediss://default:TEST_PASSWORD@your-test-database.upstash.io:6379"
TEST_REDIS_URL="rediss://default:TEST_PASSWORD@your-test-database.upstash.io:6379"

# Synthetic integrations only (never copy application secrets to this file).
JWT_SECRET=cloud-test-synthetic-user-jwt-secret-only-2026
INTERNAL_JWT_SECRET=cloud-test-synthetic-internal-jwt-secret-2026
KYC_ENCRYPTION_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
FIREBASE_ENABLED=false
CLOUDINARY_ENABLED=false
MAIL_ENABLED=false
MOMO_ENABLED=false
SEPAY_ENABLED=false
GEMINI_ENABLED=false
GEMINI_WEB_SEARCH_ENABLED=false
