{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "dev-cloud:check": "ts-node scripts/run-development-tests.ts check",
    "dev-cloud:probe": "ts-node scripts/run-development-tests.ts probe",
    "dev-cloud:status": "ts-node scripts/run-development-tests.ts status",
    "dev-cloud:migrate": "ts-node scripts/run-development-tests.ts migrate",
    "dev-cloud:booking": "ts-node scripts/run-development-tests.ts booking",
    "benchmark:reset-local": "ts-node src/scripts/reset-isolated-benchmark.ts --run",
    "prisma:studio": "prisma studio",
    "admin:create": "ts-node scripts/create-admin.ts",
    "provider:backfill-avatars": "node dist/src/scripts/backfill-provider-avatars.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:booking": "jest --config ./test/jest-booking.json --runInBand",
    "test:redis-deadline": "jest --config ./test/jest-redis-deadline.json --runInBand",
    "test:ai-consultation": "jest --config ./test/jest-ai-consultation.json --runInBand",
    "ai:evaluate": "ts-node scripts/evaluate-ai-consultation.ts",
    "ops:monitor": "node scripts/monitor-health.mjs",
    "test:ops-monitor": "node --test scripts/monitor-health.test.mjs",
    "test:organization-booking": "jest --config ./test/jest-organization-booking.json --runInBand",
    "test:organization-finance": "jest --config ./test/jest-organization-finance.json --runInBand",
    "test:organization-chat": "jest --config ./test/jest-organization-chat.json --runInBand",
    "test:organization-chat:migration": "node scripts/test-order-chat-migration.cjs",
    "test:organization-reviews": "jest --config ./test/jest-organization-reviews.json --runInBand",
    "test:organization-reviews:migration": "node scripts/test-order-review-migration.cjs",
    "test:organization-feed": "jest --config ./test/jest-organization-feed.json --runInBand",
    "test:feed-cache": "jest --config ./test/jest-feed-cache.json --runInBand",
    "feed:benchmark": "ts-node scripts/benchmark-feed-cache-db.ts",
    "load:test": "node scripts/load-test.mjs",
    "load:test:self": "node scripts/load-test.mjs --self-test",
    "test:organization-feed:migration": "node scripts/test-organization-feed-migration.cjs",
    "test:provider-notifications": "jest --config ./test/jest-provider-notifications.json --runInBand",
    "test:provider-notifications:migration": "node scripts/test-provider-notifications-migration.cjs",
    "test:provider-members": "jest --config ./test/jest-provider-members.json --runInBand",
    "test:provider-members:migration": "node scripts/test-provider-members-migration.cjs",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.build.json",
    "typecheck:test": "tsc --noEmit --incremental false -p tsconfig.spec.json",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm test -- --runInBand",
    "check:all": "npm run check && npm run test:e2e -- --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie": "^1.0.2",
    "dotenv": "^18.0.3",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.1.4",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sepay-pg-node": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "fast-xml-parser": "5.12.0",
    "follow-redirects": "1.16.2",
    "multer": "2.5.0",
    "qs": "6.16.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/testing/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}
