model ProviderFollow {
  providerId String
  userId     String
  createdAt  DateTime        @default(now())
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([providerId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("provider_follows")
}

model FeedComment {
  moderationHidden Boolean             @default(false)
  reports          FeedCommentReport[]
  id               String              @id @default(uuid())
  postId           String
  userId           String
  parentId         String?
  text             String              @db.VarChar(1000)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  post             FeedPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  parent           FeedComment?        @relation("FeedReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies          FeedComment[]       @relation("FeedReplies")

  @@index([postId, createdAt, id])
  @@index([parentId])
  @@map("feed_comments")
}

model FeedReport {
  revisionNumber Int                   @default(1)
  policyCode     String?               @db.VarChar(60)
  note           String?               @db.VarChar(500)
  id             String                @id @default(uuid())
  postId         String
  userId         String
  reason         FeedReportReason
  detail         String?               @db.VarChar(500)
  createdAt      DateTime              @default(now())
  resolution     FeedReportResolution?
  reviewedAt     DateTime?
  reviewedById   String?
  post           FeedPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     InternalAccount?      @relation("FeedReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([postId, userId, revisionNumber])
  @@index([createdAt(sort: Desc)])
  @@index([resolution, createdAt(sort: Desc)])
  @@map("feed_reports")
}

model FeedBlockedMedia {
  sha256         String   @db.VarChar(64)
  postId         String
  revisionNumber Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@id([sha256, postId, revisionNumber])
  @@map("feed_blocked_media")
}

model FeedNotice {
  transportQueuedAt DateTime?
  id                String    @id @default(uuid())
  userId            String
  postId            String
  event             String    @db.VarChar(60)
  sourceKey         String    @unique @db.VarChar(200)
  detail            String    @db.VarChar(1000)
  managed           Boolean   @default(false)
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              FeedPost  @relation(fields: [postId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt, id])
  @@map("feed_notices")
}

model FeedCommentReport {
  id           String           @id @default(uuid())
  commentId    String
  userId       String
  reason       FeedReportReason
  detail       String?          @db.VarChar(500)
  resolution   String?          @db.VarChar(30)
  reviewedById String?
  reviewedAt   DateTime?
  note         String?          @db.VarChar(500)
  createdAt    DateTime         @default(now())
  comment      FeedComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([resolution, createdAt, id])
  @@map("feed_comment_reports")
}

model ServiceOrder {
  id                         String                    @id @default(uuid())
  bookingGroupId             String                    @default(uuid())
  bookingAttempt             Int                       @default(1)
  customerId                 String
  providerId                 String
  providerServiceId          String
  assignedMemberId           String?
  assignedMemberVersion      Int?
  assignedMemberUserId       String?
  assignedMemberName         String?
  assignedMemberAvatarUrl    String?
  providerDisplayName        String?
  providerAvatarUrl          String?
  cashCollectedByUserId      String?
  cashCollectedAt            DateTime?
  cashCollectedAmount        Int?
  conversationId             String?
  customerAddressId          String?
  bookingType                BookingType
  scheduledAt                DateTime?
  expectedStartAt            DateTime
  expectedEndAt              DateTime
  clientRequestId            String?
  requestHash                String?
  status                     ServiceOrderStatus        @default(PENDING_PROVIDER)
  paymentMethod              PaymentMethod             @default(CASH)
  serviceName                String
  servicePriceAmount         Int
  travelFeeAmount            Int                       @default(0)
  travelDistanceKm           Float                     @default(0)
  distanceSource             String                    @default("CONSERVATIVE_DISTANCE")
  subtotalAmount             Int                       @default(0)
  discountAmount             Int                       @default(0)
  voucherCode                String?
  voucherIssuer              VoucherIssuer?
  platformFundedAmount       Int                       @default(0)
  providerFundedAmount       Int                       @default(0)
  totalAmount                Int
  currencyCode               String                    @default("VND")
  durationMinutes            Int
  commissionRateBps          Int
  commissionAmount           Int
  addressLabel               String
  addressLine                String
  addressProvinceName        String?
  addressDistrictName        String?
  addressWardName            String?
  addressStreetLine          String?
  addressLatitude            Float
  addressLongitude           Float
  contactName                String?
  contactPhone               String?
  addressNote                String?
  customerNote               String?
  providerResponseDeadlineAt DateTime
  acceptedAt                 DateTime?
  enRouteAt                  DateTime?
  arrivedAt                  DateTime?
  arrivalLatitude            Float?
  arrivalLongitude           Float?
  arrivalAccuracyMeters      Float?
  arrivalDistanceMeters      Int?
  paymentDisputeReason       String?
  paymentDisputeOpenedAt     DateTime?
  paymentDisputeDecidedAt    DateTime?
  paymentDisputeDecisionNote String?
  startedAt                  DateTime?
  workPausedAt               DateTime?
  totalPausedSeconds         Int                       @default(0)
  completedAt                DateTime?
  rejectedAt                 DateTime?
  rejectionReason            String?
  cancelledAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  customer                   User                      @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  provider                   ProviderProfile           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService            ProviderService           @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  assignedMember             ProviderMember?           @relation(fields: [assignedMemberId], references: [id], onDelete: Restrict)
  customerAddress            CustomerAddress?          @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  statusHistory              OrderStatusHistory[]
  walletHold                 WalletHold?
  calendarBlock              ProviderCalendarBlock?
  walletTransactions         WalletTransaction[]
  voucherRedemption          VoucherRedemption?
  evidence                   OrderEvidence[]
  cancellationRequest        OrderCancellationRequest?
  safetyIncident             OrderSafetyIncident?
  review                     OrderReview?
  notifications              OrderNotification[]
  rescheduleRequests         OrderRescheduleRequest[]
  addOns                     OrderAddOn[]
  contactAttempts            OrderContactAttempt[]
  conversation               ChatConversation?         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  bookingChat                ChatConversation?         @relation("BookingChatContext")
  chatMessages               ChatMessage[]
  operationalAlerts          OrderOperationalAlert[]

  @@unique([customerId, clientRequestId])
  @@unique([bookingGroupId, bookingAttempt])
  @@index([bookingGroupId, status])
  @@index([customerId, createdAt])
  @@index([customerId, status, providerResponseDeadlineAt])
  @@index([providerId, status, scheduledAt])
  @@index([assignedMemberId, status, expectedStartAt], map: "orders_member_status_start_idx")
  @@index([assignedMemberUserId, createdAt, id], map: "orders_assignee_history_idx")
  @@index([providerId, completedAt, id], map: "orders_provider_completed_idx")
  @@index([assignedMemberId, completedAt, id], map: "orders_member_completed_idx")
  @@index([conversationId, createdAt])
  @@index([status, providerResponseDeadlineAt])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("service_orders")
}

model OrderOperationalAlert {
  id               String                      @id @default(uuid())
  orderId          String
  type             OrderOperationalAlertType
  status           OrderOperationalAlertStatus @default(OPEN)
  detectedAt       DateTime                    @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?                     @db.Text
  updatedAt        DateTime                    @updatedAt
  order            ServiceOrder                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  acknowledgedBy   InternalAccount?            @relation("OrderAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy       InternalAccount?            @relation("OrderAlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, detectedAt])
  @@index([orderId, detectedAt])
  @@map("order_operational_alerts")
}

model Voucher {
  id                String              @id @default(uuid())
  code              String              @unique
  issuer            VoucherIssuer
  providerId        String?
  serviceId         String?
  discountType      VoucherDiscountType
  value             Int
  maxDiscountAmount Int?
  minOrderAmount    Int                 @default(0)
  startsAt          DateTime
  endsAt            DateTime
  usageLimit        Int
  perCustomerLimit  Int                 @default(1)
  status            VoucherStatus       @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  provider          ProviderProfile?    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service           Service?            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  redemptions       VoucherRedemption[]

  @@index([providerId, status, endsAt])
  @@index([status, startsAt, endsAt])
  @@map("vouchers")
}

model VoucherRedemption {
  id         String                  @id @default(uuid())
  voucherId  String
  customerId String
  orderId    String                  @unique
  status     VoucherRedemptionStatus @default(RESERVED)
  amount     Int
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  voucher    Voucher                 @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  customer   User                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      ServiceOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([voucherId, status])
  @@index([voucherId, customerId, status])
  @@map("voucher_redemptions")
}

model ChatConversation {
  id             String                 @id @default(uuid())
  customerId     String
  providerId     String
  scopeKey       String                 @default("CONSULTATION")
  bookingOrderId String?                @unique(map: "chat_booking_order_key")
  lastSequence   Int                    @default(0)
  lastMessageAt  DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  customer       User                   @relation("CustomerChats", fields: [customerId], references: [id], onDelete: Restrict)
  provider       ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  messages       ChatMessage[]
  participants   ChatParticipantState[]
  reports        ChatReport[]
  orders         ServiceOrder[]
  bookingOrder   ServiceOrder?          @relation("BookingChatContext", fields: [bookingOrderId], references: [id], onDelete: Restrict, map: "chat_booking_order_fkey")

  @@unique([customerId, providerId, scopeKey], map: "chat_pair_scope_key")
  @@index([customerId, lastMessageAt])
  @@index([providerId, lastMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id                String           @id @default(uuid())
  conversationId    String
  sequence          Int
  senderUserId      String?
  kind              ChatMessageKind
  text              String?
  providerServiceId String?
  orderId           String?
  eventKey          String?          @unique
  payload           Json?
  clientMessageId   String?
  requestHash       String?
  createdAt         DateTime         @default(now())
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender            User?            @relation("ChatSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  providerService   ProviderService? @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  order             ServiceOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attachments       ChatAttachment[]
  reports           ChatReport[]

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, sequence(sort: Desc)])
  @@map("chat_messages")
}

model ChatAttachment {
  id           String      @id @default(uuid())
  messageId    String
  publicId     String      @unique
  fileFormat   String
  deliveryType String      @default("authenticated")
  byteSize     Int
  width        Int
  height       Int
  position     Int
  createdAt    DateTime    @default(now())
  message      ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@unique([messageId, position])
  @@index([messageId])
  @@map("chat_attachments")
}

model ChatParticipantState {
  conversationId   String
  userId           String
  lastReadSequence Int              @default(0)
  blockedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@map("chat_participant_states")
}

model ChatReport {
  id             String           @id @default(uuid())
  conversationId String
  messageId      String?
  reporterUserId String
  reason         ChatReportReason
  detail         String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message        ChatMessage?     @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reporter       User             @relation(fields: [reporterUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("chat_reports")
}

model OrderEvidence {
  id               String            @id @default(uuid())
  orderId          String
  type             OrderEvidenceType
  publicId         String            @unique
  fileFormat       String
  uploadedByUserId String?
  latitude         Float?
  longitude        Float?
  capturedAt       DateTime          @default(now())
  order            ServiceOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, type])
  @@map("order_evidence")
}

model OrderCancellationRequest {
  id                String                  @id @default(uuid())
  orderId           String                  @unique
  reason            OrderCancellationReason
  detail            String
  requestedByUserId String?
  status            OrderCancellationStatus @default(PENDING_CUSTOMER)
  requestedAt       DateTime                @default(now())
  decidedAt         DateTime?
  decisionNote      String?
  order             ServiceOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@map("order_cancellation_requests")
}

model OrderSafetyIncident {
  id             String                    @id @default(uuid())
  orderId        String                    @unique
  status         OrderSafetyIncidentStatus @default(OPEN)
  createdAt      DateTime                  @default(now())
  closedAt       DateTime?
  closedById     String?
  resolutionNote String?
  order          ServiceOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  closedBy       InternalAccount?          @relation("SafetyIncidentClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reports        OrderSafetyReport[]
  evidence       OrderSafetyEvidence[]

  @@index([status, createdAt])
  @@map("order_safety_incidents")
}

model OrderSafetyReport {
  id         String              @id @default(uuid())
  incidentId String
  reporterId String
  reason     OrderSafetyReason
  detail     String?
  createdAt  DateTime            @default(now())
  incident   OrderSafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([incidentId, reporterId])
  @@map("order_safety_reports")
}

model OrderSafetyEvidence {
  id           String              @id @default(uuid())
  incidentId   String
  uploadedById String
  publicId     String              @unique
  fileFormat   String
  createdAt    DateTime            @default(now())
  incident     OrderSafetyIncident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  uploadedBy   User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([incidentId, uploadedById, createdAt])
  @@map("order_safety_evidence")
}

model OrderReview {
  id                String          @id @default(uuid())
  orderId           String          @unique
  customerId        String
  providerId        String
  memberId          String?
  membershipVersion Int?
  memberDisplayName String?
  memberAvatarUrl   String?
  rating            Int
  comment           String?
  createdAt         DateTime        @default(now())
  order             ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer          User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  member            ProviderMember? @relation(fields: [memberId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([providerId, createdAt, id])
  @@index([memberId, createdAt, id])
  @@map("order_reviews")
}

model OrderNotification {
  id           String       @id @default(uuid())
  userId       String
  orderId      String
  event        String
  readAt       DateTime?
  publishedAt  DateTime?
  pushQueuedAt DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([publishedAt, createdAt])
  @@index([pushQueuedAt, createdAt])
  @@map("order_notifications")
}

model OrderRescheduleRequest {
  id                String                @id @default(uuid())
  orderId           String
  requestedByRole   String                @default("CUSTOMER") @db.VarChar(16)
  requestedByUserId String?
  status            OrderRescheduleStatus @default(PENDING)
  proposedStartAt   DateTime
  proposedEndAt     DateTime
  expiresAt         DateTime
  createdAt         DateTime              @default(now())
  respondedAt       DateTime?
  order             ServiceOrder          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("order_reschedule_requests")
}

model OrderAddOn {
  id                  String           @id @default(uuid())
  orderId             String
  providerServiceId   String
  clientRequestId     String
  requestHash         String
  serviceName         String
  priceAmount         Int
  durationMinutes     Int
  commissionAmount    Int
  proposedTotalAmount Int
  proposedEndAt       DateTime
  confirmedEndAt      DateTime?
  note                String?
  status              OrderAddOnStatus @default(PENDING)
  expiresAt           DateTime
  createdAt           DateTime         @default(now())
  respondedAt         DateTime?
  order               ServiceOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerService     ProviderService  @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)

  @@unique([orderId, clientRequestId])
  @@index([orderId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("order_add_ons")
}

model OrderContactAttempt {
  id          String       @id @default(uuid())
  orderId     String
  attemptedAt DateTime     @default(now())
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, attemptedAt])
  @@map("order_contact_attempts")
}

model ProviderCalendarBlock {
  id               String          @id @default(uuid())
  providerId       String
  memberId         String?
  orderId          String?         @unique
  startAt          DateTime
  endAt            DateTime
  addressLatitude  Float?
  addressLongitude Float?
  active           Boolean         @default(true)
  holdExpiresAt    DateTime?
  reason           String?
  createdAt        DateTime        @default(now())
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  member           ProviderMember? @relation(fields: [memberId], references: [id], onDelete: Restrict)
  order            ServiceOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([providerId, active, startAt])
  @@index([memberId, active, startAt], map: "calendar_member_active_start_idx")
  @@index([active, holdExpiresAt])
  @@map("provider_calendar_blocks")
}

model OrderStatusHistory {
  id          String              @id @default(uuid())
  orderId     String
  fromStatus  ServiceOrderStatus?
  toStatus    ServiceOrderStatus
  actorUserId String?
  reason      String?
  createdAt   DateTime            @default(now())
  order       ServiceOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model WalletHold {
  id         String           @id @default(uuid())
  walletId   String
  orderId    String           @unique
  amount     Int
  status     WalletHoldStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  releasedAt DateTime?
  capturedAt DateTime?
  wallet     ProviderWallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order      ServiceOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@map("wallet_holds")
}

model WalletTransaction {
  id                  String                @id @default(uuid())
  walletId            String
  orderId             String?
  type                WalletTransactionType
  amount              Int
  balanceBeforeAmount Int
  balanceAfterAmount  Int
  heldBeforeAmount    Int
  heldAfterAmount     Int
  idempotencyKey      String                @unique
  reason              String?
  createdAt           DateTime              @default(now())
  wallet              ProviderWallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order               ServiceOrder?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([orderId])
  @@map("wallet_transactions")
}
