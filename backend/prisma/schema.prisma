generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  CUSTOMER
  PROVIDER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProviderType {
  INDIVIDUAL
  ORGANIZATION
}

enum ProviderApplicationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ProviderApplicationSection {
  IDENTITY
  PORTRAIT
  EXPERTISE
  SERVICES
  TERMS
}

enum ReviewStatus {
  PENDING
  VERIFIED
  NEEDS_CHANGES
  REJECTED
}

enum ProviderDocumentType {
  PORTRAIT
  ID_CARD_FRONT
  ID_CARD_BACK
  IDENTITY_SELFIE
  PROFESSIONAL_CERTIFICATE
  BUSINESS_LICENSE
  PORTFOLIO
  OTHER
}

enum ProviderProfileStatus {
  SETUP_REQUIRED
  ACTIVE
  SUSPENDED
}

enum ProviderServiceStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum ChatMessageKind {
  TEXT
  SERVICE_CARD
  ORDER_EVENT
}

enum ChatReportReason {
  SPAM
  ABUSE
  OFF_PLATFORM
  OTHER
}

enum InternalAccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum InternalRole {
  ADMIN
  MODERATOR
  SUPPORT
  KYC_REVIEWER
  SERVICE_REVIEWER
}

enum ServiceCategoryStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum ProviderServiceSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceTargetAudience {
  ALL
  MEN
  WOMEN
}

enum CustomerOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CustomerPricePreference {
  NO_PREFERENCE
  BUDGET
  BALANCED
  PREMIUM
}

enum CustomerAddressType {
  HOME
  WORK
  OTHER
}

enum BookingType {
  ASAP
  SCHEDULED
}

enum ServiceOrderStatus {
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAYMENT_DISPUTE
  DISPUTED
}

enum OrderEvidenceType {
  ARRIVAL
  BEFORE_WORK
  AFTER_WORK
  INCIDENT
}

enum OrderCancellationStatus {
  PENDING_CUSTOMER
  SUPPORT_REVIEW
  APPROVED
  DENIED
}

enum OrderCancellationReason {
  TRANSPORT_ISSUE
  CUSTOMER_UNREACHABLE
  LOCATION_INACCESSIBLE
  UNSAFE_CONDITIONS
  OTHER
}

enum PaymentMethod {
  CASH
}

enum WalletHoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum WalletTransactionType {
  HOLD
  RELEASE
  COMMISSION
  ADJUSTMENT
  TOP_UP
  REFUND
}

enum WalletTopUpStatus {
  CREATED
  PENDING_PAYMENT
  SUCCEEDED
  FAILED
  EXPIRED
}

model User {
  id                     String                  @id @default(uuid())
  phone                  String                  @unique
  firebaseUid            String?                 @unique
  phoneVerifiedAt        DateTime                @default(now())
  fullName               String?
  avatarUrl              String?
  avatarPublicId         String?
  status                 UserStatus              @default(ACTIVE)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  roles                  UserRoleAssignment[]
  providerApplications   ProviderApplication[]
  providerProfile        ProviderProfile?
  providerIdentityClaims ProviderIdentityClaim[]
  customerProfile        CustomerProfile?
  customerAddresses      CustomerAddress[]
  customerOrders         ServiceOrder[]          @relation("CustomerOrders")
  orderNotifications     OrderNotification[]
  orderReviews           OrderReview[]
  auditLogs              AuditLog[]
  sessions               UserSession[]
  customerChats          ChatConversation[]      @relation("CustomerChats")
  sentChatMessages       ChatMessage[]           @relation("ChatSender")
  chatParticipantStates  ChatParticipantState[]
  chatReports            ChatReport[]

  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model UserRoleAssignment {
  id                  String               @id @default(uuid())
  userId              String
  role                UserRole
  sourceApplicationId String?
  assignedAt          DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceApplication   ProviderApplication? @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@index([sourceApplicationId])
  @@map("user_role_assignments")
}

model InternalAccount {
  id                           String                        @id @default(uuid())
  username                     String
  normalizedUsername           String                        @unique
  fullName                     String
  email                        String?                       @unique
  status                       InternalAccountStatus         @default(INVITED)
  mustChangePassword           Boolean                       @default(true)
  failedLoginCount             Int                           @default(0)
  lockedUntil                  DateTime?
  lastLoginAt                  DateTime?
  passwordChangedAt            DateTime?
  tokenVersion                 Int                           @default(0)
  createdById                  String?
  disabledById                 String?
  disabledAt                   DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  credential                   InternalCredential?
  roles                        InternalRoleAssignment[]
  sessions                     InternalSession[]
  categoriesCreated            ServiceCategory[]             @relation("ServiceCategoryCreatedBy")
  categoriesUpdated            ServiceCategory[]             @relation("ServiceCategoryUpdatedBy")
  servicesCreated              Service[]                     @relation("ServiceCreatedBy")
  servicesUpdated              Service[]                     @relation("ServiceUpdatedBy")
  providerApplicationsReviewed ProviderApplication[]         @relation("ProviderApplicationReviewedBy")
  providerChecksReviewed       ProviderApplicationCheck[]    @relation("ProviderApplicationCheckReviewedBy")
  providerDocumentsReviewed    ProviderApplicationDocument[] @relation("ProviderApplicationDocumentReviewedBy")
  providerServicesReviewed     ProviderApplicationService[]  @relation("ProviderApplicationServiceReviewedBy")
  serviceSuggestionsReviewed   ProviderServiceSuggestion[]

  @@index([status])
  @@map("internal_accounts")
}

model InternalCredential {
  id            String          @id @default(uuid())
  accountId     String          @unique
  passwordHash  String
  hashAlgorithm String          @default("argon2id")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  account       InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("internal_credentials")
}

model InternalRoleAssignment {
  id           String          @id @default(uuid())
  accountId    String
  role         InternalRole
  assignedById String?
  assignedAt   DateTime        @default(now())
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?
  account      InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role, revokedAt])
  @@map("internal_role_assignments")
}

model InternalSession {
  id               String          @id @default(uuid())
  accountId        String
  refreshTokenHash String          @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  rotationCount    Int             @default(0)
  createdAt        DateTime        @default(now())
  account          InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("internal_sessions")
}

model AuditLog {
  id                     String   @id @default(uuid())
  actorUserId            String?
  actorInternalAccountId String?
  action                 String
  resourceType           String
  resourceId             String?
  result                 String
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  createdAt              DateTime @default(now())
  actorUser              User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([actorInternalAccountId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@map("audit_logs")
}

model ServiceCategory {
  id                 String                      @id @default(uuid())
  code               String                      @unique
  name               String
  normalizedName     String                      @unique
  slug               String                      @unique
  description        String?
  iconUrl            String?
  coverImageUrl      String?
  coverImagePublicId String?
  sortOrder          Int                         @default(0)
  status             ServiceCategoryStatus       @default(INACTIVE)
  createdById        String?
  updatedById        String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  createdBy          InternalAccount?            @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          InternalAccount?            @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  services           Service[]
  serviceSuggestions ProviderServiceSuggestion[]
  customerInterests  CustomerCategoryInterest[]

  @@index([status, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("service_categories")
}

model Service {
  id                          String                       @id @default(uuid())
  categoryId                  String
  code                        String                       @unique
  name                        String
  normalizedName              String
  slug                        String                       @unique
  description                 String?
  iconUrl                     String?
  coverImageUrl               String?
  coverImagePublicId          String?
  minPriceAmount              Int
  maxPriceAmount              Int
  currencyCode                String                       @default("VND")
  defaultDurationMinutes      Int?
  targetAudience              ServiceTargetAudience        @default(ALL)
  requiresCertificate         Boolean                      @default(false)
  minPortfolioImages          Int                          @default(0)
  minExperienceYears          Int                          @default(0)
  sortOrder                   Int                          @default(0)
  status                      ServiceStatus                @default(INACTIVE)
  createdById                 String?
  updatedById                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  category                    ServiceCategory              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy                   InternalAccount?             @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                   InternalAccount?             @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  providerApplicationServices ProviderApplicationService[]
  approvedSuggestions         ProviderServiceSuggestion[]  @relation("ApprovedSuggestedService")
  providerServices            ProviderService[]
  customerInterests           CustomerServiceInterest[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, status, sortOrder])
  @@index([targetAudience, status, sortOrder])
  @@index([status, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("services")
}

model CustomerProfile {
  id                String                     @id @default(uuid())
  userId            String                     @unique
  gender            Gender?
  preferredAudience ServiceTargetAudience      @default(ALL)
  pricePreference   CustomerPricePreference    @default(NO_PREFERENCE)
  onboardingStatus  CustomerOnboardingStatus   @default(NOT_STARTED)
  completedAt       DateTime?
  skippedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryInterests CustomerCategoryInterest[]
  serviceInterests  CustomerServiceInterest[]

  @@index([onboardingStatus])
  @@map("customer_profiles")
}

model CustomerCategoryInterest {
  id                String          @id @default(uuid())
  customerProfileId String
  categoryId        String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, categoryId])
  @@index([categoryId])
  @@map("customer_category_interests")
}

model CustomerServiceInterest {
  id                String          @id @default(uuid())
  customerProfileId String
  serviceId         String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, serviceId])
  @@index([serviceId])
  @@map("customer_service_interests")
}

model CustomerAddress {
  id             String              @id @default(uuid())
  userId         String
  type           CustomerAddressType @default(HOME)
  label          String
  addressLine    String
  provinceName   String?
  districtName   String?
  wardName       String?
  streetLine     String?
  latitude       Float
  longitude      Float
  isMapConfirmed Boolean             @default(false)
  contactName    String?
  contactPhone   String?
  note           String?
  isDefault      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         ServiceOrder[]

  @@index([userId, isDefault])
  @@map("customer_addresses")
}

model ProviderApplication {
  id                         String                               @id @default(uuid())
  userId                     String
  providerType               ProviderType
  status                     ProviderApplicationStatus            @default(DRAFT)
  revisionNumber             Int                                  @default(0)
  legalFullName              String?
  birthDate                  DateTime?                            @db.Date
  gender                     Gender?
  email                      String?
  biography                  String?
  nationalIdNumber           String?
  nationalIdEncrypted        String?
  nationalIdHash             String?
  nationalIdLast4            String?
  experienceYears            Int?
  organizationName           String?
  taxCode                    String?
  businessRegistrationNumber String?
  registeredAddress          String?
  representativeName         String?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedById               String?
  decisionReason             String?
  withdrawnAt                DateTime?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  user                       User                                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy                 InternalAccount?                     @relation("ProviderApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  revisions                  ProviderApplicationRevision[]
  checks                     ProviderApplicationCheck[]
  documents                  ProviderApplicationDocument[]
  services                   ProviderApplicationService[]
  serviceSuggestions         ProviderServiceSuggestion[]
  termsAcceptances           ProviderApplicationTermsAcceptance[]
  grantedRoles               UserRoleAssignment[]
  providerProfile            ProviderProfile?
  providerServices           ProviderService[]

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
  @@index([nationalIdHash])
  @@map("provider_applications")
}

// Identity ownership survives rejected/withdrawn applications without duplicating PII.
model ProviderIdentityClaim {
  nationalIdHash String   @id
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("provider_identity_claims")
}

model MailOutbox {
  id               String    @id @default(uuid())
  deduplicationKey String    @unique
  recipient        String
  subject          String
  text             String
  html             String
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now())
  lockedUntil      DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([sentAt, failedAt, availableAt])
  @@map("mail_outbox")
}

model ProviderApplicationRevision {
  id             String              @id @default(uuid())
  applicationId  String
  revisionNumber Int
  snapshot       Json
  submittedAt    DateTime            @default(now())
  application    ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, revisionNumber])
  @@map("provider_application_revisions")
}

model ProviderApplicationCheck {
  id            String                     @id @default(uuid())
  applicationId String
  section       ProviderApplicationSection
  status        ReviewStatus               @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  application   ProviderApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy    InternalAccount?           @relation("ProviderApplicationCheckReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, section])
  @@index([status])
  @@index([reviewedById])
  @@map("provider_application_checks")
}

model ProviderApplicationDocument {
  id                   String                      @id @default(uuid())
  applicationId        String
  applicationServiceId String?
  type                 ProviderDocumentType
  fileUrl              String
  publicId             String
  fileFormat           String?
  deliveryType         String                      @default("upload")
  isPublicCandidate    Boolean                     @default(false)
  status               ReviewStatus                @default(PENDING)
  reviewNote           String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  application          ProviderApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationService   ProviderApplicationService? @relation(fields: [applicationServiceId], references: [id], onDelete: Cascade)
  reviewedBy           InternalAccount?            @relation("ProviderApplicationDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId, type])
  @@index([applicationServiceId])
  @@index([reviewedById])
  @@map("provider_application_documents")
}

model ProviderApplicationService {
  id                  String                        @id @default(uuid())
  applicationId       String
  serviceId           String
  proposedPriceAmount Int
  durationMinutes     Int?
  description         String?
  status              ReviewStatus                  @default(PENDING)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  application         ProviderApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  service             Service                       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  reviewedBy          InternalAccount?              @relation("ProviderApplicationServiceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents           ProviderApplicationDocument[]

  @@unique([applicationId, serviceId])
  @@index([serviceId, status])
  @@index([reviewedById])
  @@map("provider_application_services")
}

model ProviderServiceSuggestion {
  id                  String                          @id @default(uuid())
  applicationId       String
  categoryId          String
  name                String
  normalizedName      String
  description         String?
  proposedPriceAmount Int
  durationMinutes     Int?
  status              ProviderServiceSuggestionStatus @default(PENDING)
  reviewNote          String?
  approvedServiceId   String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  application         ProviderApplication             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category            ServiceCategory                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedService     Service?                        @relation("ApprovedSuggestedService", fields: [approvedServiceId], references: [id], onDelete: SetNull)
  reviewedBy          InternalAccount?                @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, categoryId, normalizedName])
  @@index([applicationId, status])
  @@index([status, createdAt])
  @@index([approvedServiceId])
  @@index([reviewedById])
  @@map("provider_service_suggestions")
}

model ProviderApplicationTermsAcceptance {
  id            String              @id @default(uuid())
  applicationId String
  termsVersion  String
  acceptedAt    DateTime            @default(now())
  ipAddress     String?
  userAgent     String?
  application   ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, termsVersion])
  @@map("provider_application_terms_acceptances")
}

model ProviderProfile {
  id                   String                        @id @default(uuid())
  userId               String                        @unique
  sourceApplicationId  String                        @unique
  providerType         ProviderType
  displayName          String
  avatarUrl            String?
  biography            String?
  experienceYears      Int?
  status               ProviderProfileStatus         @default(SETUP_REQUIRED)
  serviceAreaName      String?
  serviceAreaLatitude  Float?
  serviceAreaLongitude Float?
  serviceRadiusKm      Int?
  setupCompletedAt     DateTime?
  workingHours         ProviderWorkingHour[]
  availabilitySessions ProviderAvailabilitySession[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  user                 User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceApplication    ProviderApplication           @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)
  wallet               ProviderWallet?
  services             ProviderService[]
  orders               ServiceOrder[]
  orderReviews         OrderReview[]
  calendarBlocks       ProviderCalendarBlock[]
  chatConversations    ChatConversation[]

  @@index([status])
  @@map("provider_profiles")
}

model ProviderAvailabilitySession {
  id              String          @id @default(uuid())
  providerId      String
  startedAt       DateTime        @default(now())
  lastHeartbeatAt DateTime        @default(now())
  endedAt         DateTime?
  endReason       String?
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, endedAt])
  @@index([lastHeartbeatAt])
  @@map("provider_availability_sessions")
}

model ProviderWorkingHour {
  id          String          @id @default(uuid())
  providerId  String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek, startMinute])
  @@map("provider_working_hours")
}

model ProviderWallet {
  id            String               @id @default(uuid())
  providerId    String               @unique
  balanceAmount Int                  @default(0)
  heldAmount    Int                  @default(0)
  currencyCode  String               @default("VND")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  provider      ProviderProfile      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  holds         WalletHold[]
  transactions  WalletTransaction[]
  topUps        WalletTopUpRequest[]

  @@map("provider_wallets")
}

model WalletTopUpRequest {
  id            String            @id @default(uuid())
  walletId      String
  amount        Int
  status        WalletTopUpStatus @default(CREATED)
  provider      String            @default("MOMO")
  orderId       String            @unique
  requestId     String            @unique
  orderInfo     String
  extraData     String            @default("")
  payUrl        String?
  deeplink      String?
  qrCodeUrl     String?
  momoTransId   String?           @unique
  sepayTransId  String?           @unique
  checkoutData  Json?
  resultCode    Int?
  resultMessage String?
  paidAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  wallet        ProviderWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([status, expiresAt])
  @@map("wallet_top_up_requests")
}

model ProviderService {
  id                  String                @id @default(uuid())
  providerId          String
  serviceId           String
  sourceApplicationId String
  priceAmount         Int
  durationMinutes     Int?
  description         String?
  status              ProviderServiceStatus @default(INACTIVE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  provider            ProviderProfile       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service             Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sourceApplication   ProviderApplication   @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)
  orders              ServiceOrder[]
  chatMessages        ChatMessage[]

  @@unique([providerId, serviceId])
  @@index([serviceId, status])
  @@index([sourceApplicationId])
  @@map("provider_services")
}

model ServiceOrder {
  id                         String                    @id @default(uuid())
  customerId                 String
  providerId                 String
  providerServiceId          String
  conversationId             String?
  customerAddressId          String?
  bookingType                BookingType
  scheduledAt                DateTime?
  expectedStartAt            DateTime
  expectedEndAt              DateTime
  clientRequestId            String?
  requestHash                String?
  status                     ServiceOrderStatus        @default(PENDING_PROVIDER)
  paymentMethod              PaymentMethod             @default(CASH)
  serviceName                String
  servicePriceAmount         Int
  travelFeeAmount            Int                       @default(0)
  totalAmount                Int
  currencyCode               String                    @default("VND")
  durationMinutes            Int
  commissionRateBps          Int
  commissionAmount           Int
  addressLabel               String
  addressLine                String
  addressProvinceName        String?
  addressDistrictName        String?
  addressWardName            String?
  addressStreetLine          String?
  addressLatitude            Float
  addressLongitude           Float
  contactName                String?
  contactPhone               String?
  addressNote                String?
  customerNote               String?
  providerResponseDeadlineAt DateTime
  acceptedAt                 DateTime?
  enRouteAt                  DateTime?
  arrivedAt                  DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  rejectedAt                 DateTime?
  rejectionReason            String?
  cancelledAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  customer                   User                      @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  provider                   ProviderProfile           @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService            ProviderService           @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  customerAddress            CustomerAddress?          @relation(fields: [customerAddressId], references: [id], onDelete: SetNull)
  statusHistory              OrderStatusHistory[]
  walletHold                 WalletHold?
  calendarBlock              ProviderCalendarBlock?
  walletTransactions         WalletTransaction[]
  evidence                   OrderEvidence[]
  cancellationRequest        OrderCancellationRequest?
  review                     OrderReview?
  notifications              OrderNotification[]
  contactAttempts            OrderContactAttempt[]
  conversation               ChatConversation?         @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  chatMessages               ChatMessage[]

  @@unique([customerId, clientRequestId])
  @@index([customerId, createdAt])
  @@index([customerId, status, providerResponseDeadlineAt])
  @@index([providerId, status, scheduledAt])
  @@index([conversationId, createdAt])
  @@index([status, providerResponseDeadlineAt])
  @@map("service_orders")
}

model ChatConversation {
  id             String                 @id @default(uuid())
  customerId     String
  providerId     String
  lastSequence   Int                    @default(0)
  lastMessageAt  DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  customer       User                   @relation("CustomerChats", fields: [customerId], references: [id], onDelete: Restrict)
  provider       ProviderProfile        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  messages       ChatMessage[]
  participants   ChatParticipantState[]
  reports        ChatReport[]
  orders         ServiceOrder[]

  @@unique([customerId, providerId])
  @@index([customerId, lastMessageAt])
  @@index([providerId, lastMessageAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id                String           @id @default(uuid())
  conversationId    String
  sequence          Int
  senderUserId      String?
  kind              ChatMessageKind
  text              String?
  providerServiceId String?
  orderId           String?
  eventKey          String?          @unique
  payload           Json?
  clientMessageId   String?
  requestHash       String?
  createdAt         DateTime         @default(now())
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender            User?            @relation("ChatSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  providerService   ProviderService? @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  order             ServiceOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reports           ChatReport[]

  @@unique([conversationId, sequence])
  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([conversationId, sequence(sort: Desc)])
  @@map("chat_messages")
}

model ChatParticipantState {
  conversationId   String
  userId           String
  lastReadSequence Int              @default(0)
  blockedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  conversation     ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@map("chat_participant_states")
}

model ChatReport {
  id             String           @id @default(uuid())
  conversationId String
  messageId      String?
  reporterUserId String
  reason         ChatReportReason
  detail         String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message        ChatMessage?     @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reporter       User             @relation(fields: [reporterUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("chat_reports")
}

model OrderEvidence {
  id         String            @id @default(uuid())
  orderId    String
  type       OrderEvidenceType
  publicId   String            @unique
  fileFormat String
  latitude   Float?
  longitude  Float?
  capturedAt DateTime          @default(now())
  order      ServiceOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@map("order_evidence")
}

model OrderCancellationRequest {
  id           String                  @id @default(uuid())
  orderId      String                  @unique
  reason       OrderCancellationReason
  detail       String
  status       OrderCancellationStatus @default(PENDING_CUSTOMER)
  requestedAt  DateTime                @default(now())
  decidedAt    DateTime?
  decisionNote String?
  order        ServiceOrder            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@map("order_cancellation_requests")
}

model OrderReview {
  id         String          @id @default(uuid())
  orderId    String          @unique
  customerId String
  providerId String
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())
  order      ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer   User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@map("order_reviews")
}

model OrderNotification {
  id        String       @id @default(uuid())
  userId    String
  orderId   String
  event     String
  readAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("order_notifications")
}

model OrderContactAttempt {
  id          String       @id @default(uuid())
  orderId     String
  attemptedAt DateTime     @default(now())
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, attemptedAt])
  @@map("order_contact_attempts")
}

model ProviderCalendarBlock {
  id               String          @id @default(uuid())
  providerId       String
  orderId          String?         @unique
  startAt          DateTime
  endAt            DateTime
  addressLatitude  Float?
  addressLongitude Float?
  active           Boolean         @default(true)
  holdExpiresAt    DateTime?
  reason           String?
  createdAt        DateTime        @default(now())
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  order            ServiceOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([providerId, active, startAt])
  @@index([active, holdExpiresAt])
  @@map("provider_calendar_blocks")
}

model OrderStatusHistory {
  id          String              @id @default(uuid())
  orderId     String
  fromStatus  ServiceOrderStatus?
  toStatus    ServiceOrderStatus
  actorUserId String?
  reason      String?
  createdAt   DateTime            @default(now())
  order       ServiceOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model WalletHold {
  id         String           @id @default(uuid())
  walletId   String
  orderId    String           @unique
  amount     Int
  status     WalletHoldStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  releasedAt DateTime?
  capturedAt DateTime?
  wallet     ProviderWallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order      ServiceOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@map("wallet_holds")
}

model WalletTransaction {
  id                  String                @id @default(uuid())
  walletId            String
  orderId             String?
  type                WalletTransactionType
  amount              Int
  balanceBeforeAmount Int
  balanceAfterAmount  Int
  heldBeforeAmount    Int
  heldAfterAmount     Int
  idempotencyKey      String                @unique
  reason              String?
  createdAt           DateTime              @default(now())
  wallet              ProviderWallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order               ServiceOrder?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([orderId])
  @@map("wallet_transactions")
}
