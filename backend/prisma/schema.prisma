generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserRole {
  CUSTOMER
  PROVIDER
}

enum PushPlatform {
  ANDROID
  IOS
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ProviderType {
  INDIVIDUAL
  ORGANIZATION
}

enum ProviderMemberRole {
  OWNER
  WORKER
}

enum ProviderMemberStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LEFT
}

enum ProviderMemberInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum ProviderMemberVerificationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum ProviderApplicationStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ProviderApplicationSection {
  IDENTITY
  PORTRAIT
  EXPERTISE
  SERVICES
  TERMS
}

enum ReviewStatus {
  PENDING
  VERIFIED
  NEEDS_CHANGES
  REJECTED
}

enum ProviderDocumentType {
  PORTRAIT
  ID_CARD_FRONT
  ID_CARD_BACK
  IDENTITY_SELFIE
  PROFESSIONAL_CERTIFICATE
  BUSINESS_LICENSE
  PORTFOLIO
  OTHER
}

enum ProviderProfileStatus {
  SETUP_REQUIRED
  ACTIVE
  SUSPENDED
}

enum ProviderServiceStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum ProviderServiceChangeType {
  ADD_EXISTING_SERVICE
  UPDATE_OFFERING
  PROPOSE_NEW_SERVICE
}

enum ProviderServiceChangeStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  WITHDRAWN
}

enum FeedPostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum FeedModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedRecommendationStatus {
  INELIGIBLE
  ELIGIBLE
}

enum FeedOrganizationReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedMediaKind {
  IMAGE
  VIDEO
}

enum FeedReportReason {
  SPAM
  INAPPROPRIATE
  PRIVACY
  MISLEADING
  OTHER
}

enum FeedReportResolution {
  DISMISSED
  POST_HIDDEN
  NO_VIOLATION
  CONTENT_RESTRICTED
  CONTENT_REMOVED
}

enum ChatMessageKind {
  TEXT
  IMAGE
  SERVICE_CARD
  ORDER_EVENT
}

enum ChatReportReason {
  SPAM
  ABUSE
  OFF_PLATFORM
  OTHER
}

enum InternalAccountStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum InternalRole {
  ADMIN
  MODERATOR
  SUPPORT
  KYC_REVIEWER
  SERVICE_REVIEWER
}

enum ServiceCategoryStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  INACTIVE
  ACTIVE
  ARCHIVED
}

enum ProviderServiceSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceTargetAudience {
  ALL
  MEN
  WOMEN
}

enum CustomerOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CustomerPricePreference {
  NO_PREFERENCE
  BUDGET
  BALANCED
  PREMIUM
}

enum CustomerAddressType {
  HOME
  WORK
  OTHER
}

enum BookingType {
  ASAP
  SCHEDULED
}

enum ServiceOrderStatus {
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  SAFETY_HOLD
  COMPLETED
  PAYMENT_DISPUTE
  DISPUTED
}

enum OrderOperationalAlertType {
  ACCEPTED_START_OVERDUE
  EN_ROUTE_OVERDUE
  ARRIVAL_START_OVERDUE
  SERVICE_COMPLETION_OVERDUE
  SAFETY_HOLD_STALE
  PAYMENT_DISPUTE_STALE
  DISPUTED_STALE
  CANCELLATION_REVIEW_STALE
}

enum OrderOperationalAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum OrderRescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderAddOnStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum OrderEvidenceType {
  ARRIVAL
  BEFORE_WORK
  AFTER_WORK
  INCIDENT
}

enum OrderCancellationStatus {
  PENDING_CUSTOMER
  SUPPORT_REVIEW
  APPROVED
  DENIED
}

enum OrderCancellationReason {
  TRANSPORT_ISSUE
  CUSTOMER_UNREACHABLE
  LOCATION_INACCESSIBLE
  UNSAFE_CONDITIONS
  OTHER
}

enum OrderSafetyIncidentStatus {
  OPEN
  CLOSED
}

enum OrderSafetyReason {
  THREAT
  VIOLENCE
  THEFT
  MEDICAL
  OTHER
}

enum PaymentMethod {
  CASH
}

enum WalletHoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum WalletTransactionType {
  HOLD
  RELEASE
  COMMISSION
  ADJUSTMENT
  TOP_UP
  REFUND
  VOUCHER_REIMBURSEMENT
}

enum VoucherIssuer {
  PLATFORM
  PROVIDER
}

enum VoucherDiscountType {
  FIXED_AMOUNT
  PERCENTAGE
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
}

enum VoucherRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
}

enum WalletTopUpStatus {
  CREATED
  PENDING_PAYMENT
  SUCCEEDED
  FAILED
  EXPIRED
}

model User {
  guidanceProgress            UserGuidanceProgress[]
  feedNotices                 FeedNotice[]
  feedCommentReports          FeedCommentReport[]
  id                          String                     @id @default(uuid())
  phone                       String                     @unique
  firebaseUid                 String?                    @unique
  phoneVerifiedAt             DateTime                   @default(now())
  fullName                    String?
  avatarUrl                   String?
  avatarPublicId              String?
  status                      UserStatus                 @default(ACTIVE)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  roles                       UserRoleAssignment[]
  providerApplications        ProviderApplication[]
  providerProfile             ProviderProfile?
  providerMemberships         ProviderMember[]
  sentProviderInvitations     ProviderMemberInvitation[] @relation("ProviderInvitationSender")
  answeredProviderInvitations ProviderMemberInvitation[] @relation("ProviderInvitationResponder")
  providerIdentityClaims      ProviderIdentityClaim[]
  customerProfile             CustomerProfile?
  customerAddresses           CustomerAddress[]
  customerOrders              ServiceOrder[]             @relation("CustomerOrders")
  voucherRedemptions          VoucherRedemption[]
  orderNotifications          OrderNotification[]
  safetyReports               OrderSafetyReport[]
  safetyEvidence              OrderSafetyEvidence[]
  orderReviews                OrderReview[]
  auditLogs                   AuditLog[]
  sessions                    UserSession[]
  pushDevices                 UserPushDevice[]
  pushOutbox                  PushOutbox[]
  providerAccountSignal       ProviderAccountSignal?
  customerChats               ChatConversation[]         @relation("CustomerChats")
  sentChatMessages            ChatMessage[]              @relation("ChatSender")
  chatParticipantStates       ChatParticipantState[]
  chatReports                 ChatReport[]
  aiConversations             AiConversation[]
  aiActionEvents              AiActionEvent[]
  aiUsageEntries              AiUsageEntry[]
  feedLikes                   FeedLike[]
  feedSaves                   FeedSave[]
  feedComments                FeedComment[]
  feedReports                 FeedReport[]
  feedEngagements             FeedEngagement[]
  providerFollows             ProviderFollow[]

  @@map("users")
}

model UserGuidanceProgress {
  userId    String
  tourId    String   @db.VarChar(64)
  version   Int
  stepIndex Int      @default(0)
  status    String   @db.VarChar(16)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tourId, version])
  @@map("user_guidance_progress")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id                  String             @id @default(uuid())
  conversationId      String
  clientMessageId     String?
  role                String
  text                String             @db.Text
  result              Json?
  processingToken     String?
  processingStartedAt DateTime?
  createdAt           DateTime           @default(now())
  conversation        AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actionEvents        AiActionEvent[]
  feedback            AiMessageFeedback?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum AiFeedbackReason {
  NOT_RELEVANT
  INCORRECT
  UNSAFE
  OTHER
}

model AiMessageFeedback {
  messageId String            @id
  helpful   Boolean
  reason    AiFeedbackReason?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  message   AiMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("ai_message_feedback")
}

model AiUsageEntry {
  messageId String   @id
  userId    String
  day       DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@map("ai_usage_entries")
}

model AiActionEvent {
  id         String    @id @default(uuid())
  userId     String
  messageId  String
  actionType String
  targetId   String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actionType, createdAt])
  @@map("ai_action_events")
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  rotationCount    Int       @default(0)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}

model UserPushDevice {
  id         String       @id @default(uuid())
  userId     String
  sessionId  String
  platform   PushPlatform
  deviceId   String       @db.VarChar(128)
  token      String       @db.Text
  tokenHash  String       @unique @db.Char(64)
  appVersion String?      @db.VarChar(64)
  lastSeenAt DateTime     @default(now())
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, deviceId])
  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@map("user_push_devices")
}

model PushOutbox {
  id               String    @id @default(uuid())
  userId           String
  deviceId         String
  deduplicationKey String    @unique @db.VarChar(200)
  event            String    @db.VarChar(80)
  entityType       String    @db.VarChar(30)
  entityId         String
  sourceId         String?
  recipientRole    String    @db.VarChar(20)
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now())
  lockedUntil      DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([availableAt, lockedUntil])
  @@index([userId, createdAt])
  @@map("push_outbox")
}

model UserRoleAssignment {
  id                  String               @id @default(uuid())
  userId              String
  role                UserRole
  sourceApplicationId String?
  assignedAt          DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceApplication   ProviderApplication? @relation(fields: [sourceApplicationId], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@index([sourceApplicationId])
  @@map("user_role_assignments")
}

model InternalAccount {
  id                             String                         @id @default(uuid())
  username                       String
  normalizedUsername             String                         @unique
  fullName                       String
  email                          String?                        @unique
  status                         InternalAccountStatus          @default(INVITED)
  mustChangePassword             Boolean                        @default(true)
  failedLoginCount               Int                            @default(0)
  lockedUntil                    DateTime?
  lastLoginAt                    DateTime?
  passwordChangedAt              DateTime?
  tokenVersion                   Int                            @default(0)
  createdById                    String?
  disabledById                   String?
  disabledAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  credential                     InternalCredential?
  setupTokens                    InternalSetupToken[]
  roles                          InternalRoleAssignment[]
  sessions                       InternalSession[]
  categoriesCreated              ServiceCategory[]              @relation("ServiceCategoryCreatedBy")
  categoriesUpdated              ServiceCategory[]              @relation("ServiceCategoryUpdatedBy")
  servicesCreated                Service[]                      @relation("ServiceCreatedBy")
  servicesUpdated                Service[]                      @relation("ServiceUpdatedBy")
  providerApplicationsReviewed   ProviderApplication[]          @relation("ProviderApplicationReviewedBy")
  providerChecksReviewed         ProviderApplicationCheck[]     @relation("ProviderApplicationCheckReviewedBy")
  providerDocumentsReviewed      ProviderApplicationDocument[]  @relation("ProviderApplicationDocumentReviewedBy")
  providerServicesReviewed       ProviderApplicationService[]   @relation("ProviderApplicationServiceReviewedBy")
  serviceSuggestionsReviewed     ProviderServiceSuggestion[]
  providerServiceChangesReviewed ProviderServiceChangeRequest[]
  closedSafetyIncidents          OrderSafetyIncident[]          @relation("SafetyIncidentClosedBy")
  feedReportsReviewed            FeedReport[]                   @relation("FeedReportReviewedBy")
  orderAlertsAcknowledged        OrderOperationalAlert[]        @relation("OrderAlertAcknowledgedBy")
  orderAlertsResolved            OrderOperationalAlert[]        @relation("OrderAlertResolvedBy")

  @@index([status])
  @@map("internal_accounts")
}

model InternalCredential {
  id            String          @id @default(uuid())
  accountId     String          @unique
  passwordHash  String
  hashAlgorithm String          @default("argon2id")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  account       InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("internal_credentials")
}

model InternalSetupToken {
  id         String          @id @default(uuid())
  accountId  String
  tokenHash  String          @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())
  account    InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, consumedAt])
  @@index([expiresAt])
  @@map("internal_setup_tokens")
}

model InternalRoleAssignment {
  id           String          @id @default(uuid())
  accountId    String
  role         InternalRole
  assignedById String?
  assignedAt   DateTime        @default(now())
  revokedById  String?
  revokedAt    DateTime?
  revokeReason String?
  account      InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, role])
  @@index([role, revokedAt])
  @@map("internal_role_assignments")
}

model InternalSession {
  id               String          @id @default(uuid())
  accountId        String
  refreshTokenHash String          @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  rotationCount    Int             @default(0)
  createdAt        DateTime        @default(now())
  account          InternalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("internal_sessions")
}

model AuditLog {
  id                     String   @id @default(uuid())
  actorUserId            String?
  actorInternalAccountId String?
  action                 String
  resourceType           String
  resourceId             String?
  result                 String
  metadata               Json?
  ipAddress              String?
  userAgent              String?
  requestId              String?
  createdAt              DateTime @default(now())
  actorUser              User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([actorInternalAccountId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@map("audit_logs")
}

model ServiceCategory {
  id                     String                         @id @default(uuid())
  code                   String                         @unique
  name                   String
  normalizedName         String                         @unique
  slug                   String                         @unique
  description            String?
  iconUrl                String?
  coverImageUrl          String?
  coverImagePublicId     String?
  sortOrder              Int                            @default(0)
  status                 ServiceCategoryStatus          @default(INACTIVE)
  createdById            String?
  updatedById            String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  createdBy              InternalAccount?               @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              InternalAccount?               @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  services               Service[]
  serviceSuggestions     ProviderServiceSuggestion[]
  providerServiceChanges ProviderServiceChangeRequest[]
  customerInterests      CustomerCategoryInterest[]

  @@index([status, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("service_categories")
}

model Service {
  id                          String                         @id @default(uuid())
  categoryId                  String
  code                        String                         @unique
  name                        String
  normalizedName              String
  slug                        String                         @unique
  description                 String?
  iconUrl                     String?
  coverImageUrl               String?
  coverImagePublicId          String?
  minPriceAmount              Int
  maxPriceAmount              Int
  currencyCode                String                         @default("VND")
  defaultDurationMinutes      Int?
  targetAudience              ServiceTargetAudience          @default(ALL)
  requiresCertificate         Boolean                        @default(false)
  minPortfolioImages          Int                            @default(0)
  minExperienceYears          Int                            @default(0)
  sortOrder                   Int                            @default(0)
  status                      ServiceStatus                  @default(INACTIVE)
  createdById                 String?
  updatedById                 String?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  category                    ServiceCategory                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy                   InternalAccount?               @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                   InternalAccount?               @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  providerApplicationServices ProviderApplicationService[]
  approvedSuggestions         ProviderServiceSuggestion[]    @relation("ApprovedSuggestedService")
  providerServiceChanges      ProviderServiceChangeRequest[]
  providerServices            ProviderService[]
  vouchers                    Voucher[]
  customerInterests           CustomerServiceInterest[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, status, sortOrder])
  @@index([targetAudience, status, sortOrder])
  @@index([status, sortOrder])
  @@index([createdById])
  @@index([updatedById])
  @@map("services")
}

model CustomerProfile {
  id                String                     @id @default(uuid())
  userId            String                     @unique
  gender            Gender?
  preferredAudience ServiceTargetAudience      @default(ALL)
  pricePreference   CustomerPricePreference    @default(NO_PREFERENCE)
  onboardingStatus  CustomerOnboardingStatus   @default(NOT_STARTED)
  completedAt       DateTime?
  skippedAt         DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryInterests CustomerCategoryInterest[]
  serviceInterests  CustomerServiceInterest[]

  @@index([onboardingStatus])
  @@map("customer_profiles")
}

model CustomerCategoryInterest {
  id                String          @id @default(uuid())
  customerProfileId String
  categoryId        String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  category          ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, categoryId])
  @@index([categoryId])
  @@map("customer_category_interests")
}

model CustomerServiceInterest {
  id                String          @id @default(uuid())
  customerProfileId String
  serviceId         String
  createdAt         DateTime        @default(now())
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  service           Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, serviceId])
  @@index([serviceId])
  @@map("customer_service_interests")
}

model CustomerAddress {
  id             String              @id @default(uuid())
  userId         String
  type           CustomerAddressType @default(HOME)
  label          String
  addressLine    String
  provinceName   String?
  districtName   String?
  wardName       String?
  streetLine     String?
  latitude       Float
  longitude      Float
  isMapConfirmed Boolean             @default(false)
  contactName    String?
  contactPhone   String?
  note           String?
  isDefault      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         ServiceOrder[]

  @@index([userId, isDefault])
  @@map("customer_addresses")
}

model ProviderApplication {
  id                         String                               @id @default(uuid())
  userId                     String
  providerType               ProviderType
  status                     ProviderApplicationStatus            @default(DRAFT)
  revisionNumber             Int                                  @default(0)
  legalFullName              String?
  birthDate                  DateTime?                            @db.Date
  gender                     Gender?
  email                      String?
  biography                  String?
  nationalIdEncrypted        String?
  nationalIdHash             String?
  nationalIdLast4            String?
  experienceYears            Int?
  organizationName           String?
  taxCode                    String?
  businessRegistrationNumber String?
  registeredAddress          String?
  representativeName         String?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedById               String?
  decisionReason             String?
  withdrawnAt                DateTime?
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt
  user                       User                                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy                 InternalAccount?                     @relation("ProviderApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  revisions                  ProviderApplicationRevision[]
  checks                     ProviderApplicationCheck[]
  documents                  ProviderApplicationDocument[]
  services                   ProviderApplicationService[]
  serviceSuggestions         ProviderServiceSuggestion[]
  termsAcceptances           ProviderApplicationTermsAcceptance[]
  grantedRoles               UserRoleAssignment[]
  providerProfile            ProviderProfile?
  providerServices           ProviderService[]

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([reviewedById])
  @@index([nationalIdHash])
  @@map("provider_applications")
}

// Identity ownership survives rejected/withdrawn applications without duplicating PII.
model ProviderIdentityClaim {
  nationalIdHash String   @id
  userId         String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("provider_identity_claims")
}

model MailOutbox {
  id               String    @id @default(uuid())
  deduplicationKey String    @unique
  recipient        String
  subject          String
  text             String
  html             String
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now())
  lockedUntil      DateTime?
  sentAt           DateTime?
  failedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([sentAt, failedAt, availableAt])
  @@map("mail_outbox")
}

model ProviderApplicationRevision {
  id             String              @id @default(uuid())
  applicationId  String
  revisionNumber Int
  snapshot       Json
  submittedAt    DateTime            @default(now())
  application    ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, revisionNumber])
  @@map("provider_application_revisions")
}

model ProviderApplicationCheck {
  id            String                     @id @default(uuid())
  applicationId String
  section       ProviderApplicationSection
  status        ReviewStatus               @default(PENDING)
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  application   ProviderApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy    InternalAccount?           @relation("ProviderApplicationCheckReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([applicationId, section])
  @@index([status])
  @@index([reviewedById])
  @@map("provider_application_checks")
}

model ProviderApplicationDocument {
